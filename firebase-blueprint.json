{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "createdAt"]
    },
    "Scan": {
      "title": "Scan",
      "description": "Result of a scene recognition scan.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "resultId": { "type": "string", "description": "TMDB movie ID" },
        "movieTitle": { "type": "string" },
        "confidence": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "resultId", "createdAt"]
    },
    "WatchlistItem": {
      "title": "Watchlist Item",
      "description": "A movie saved to a user's watchlist.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "movieId": { "type": "string" },
        "movieTitle": { "type": "string" },
        "posterPath": { "type": "string" },
        "addedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "movieId", "addedAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "AI Assistant chat history.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": { "type": "string", "enum": ["user", "model"] },
              "content": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" }
            }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "messages"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles."
    },
    "scans/{scanId}": {
      "schema": "Scan",
      "description": "Scan history."
    },
    "watchlists/{watchId}": {
      "schema": "WatchlistItem",
      "description": "User watchlists."
    },
    "conversations/{convId}": {
      "schema": "Conversation",
      "description": "Chat history."
    }
  }
}
