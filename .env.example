# ── Groq AI ────────────────────────────────────
# Required for AI recognition and chat. Get yours at:
# https://console.groq.com/keys
VITE_GROQ_API_KEY="your_groq_api_key_here"

# ── TMDB ───────────────────────────────────────
# Required for movie metadata. Get yours at:
# https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY="your_tmdb_api_key_here"

# ── API Backend URL ────────────────────────────
# Set this to your Render API URL in production
# Leave empty for local dev (defaults to /api proxy)
VITE_API_URL="/api"

# ── Auth ───────────────────────────────────────
# Generate: openssl rand -hex 64
JWT_SECRET="your_jwt_secret_here"

# ── Database ───────────────────────────────────
# Render auto-sets MONGODB_URL via the database link
MONGODB_URL="mongodb://localhost:27017/cight"

# ── CORS ───────────────────────────────────────
# Set to your Railway frontend URL in production
FRONTEND_URL="http://localhost:5179"