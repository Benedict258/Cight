# Groq API Key (required for AI recognition and chat)
# Get yours at: https://console.groq.com/keys
VITE_GROQ_API_KEY="your_groq_api_key_here"

# TMDB API Key (required for movie metadata)
# Get yours at: https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY="your_tmdb_api_key_here"

# JWT Secret (used for auth token signing)
# Generate one: openssl rand -hex 64
JWT_SECRET="your_jwt_secret_here"

# MongoDB Connection String
# Railway auto-sets MONGODB_URL when you add a MongoDB service
MONGODB_URL="mongodb://localhost:27017/cight"

# Application URL
APP_URL="http://localhost:5179"