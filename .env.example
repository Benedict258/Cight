# Gemini API Key (required for AI recognition and chat)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# TMDB API Key (required for movie metadata)
# Get yours at: https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY="your_tmdb_api_key_here"

# Application URL (used for self-referential links and OAuth callbacks)
APP_URL="http://localhost:5179"
