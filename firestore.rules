rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 0.1 Test Connection
    match /test/connection {
      allow get: if true;
    }

    // 3. Primitives
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }

    // 2. Validation Blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'createdAt']) &&
             data.id == request.auth.uid &&
             data.email is string &&
             data.email.size() <= 256 &&
             (data.createdAt == request.time || data.createdAt == resource.data.createdAt);
    }

    function isValidScan(data) {
      return data.keys().hasAll(['userId', 'resultId', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.resultId is string &&
             data.resultId.size() <= 256 &&
             (data.createdAt == request.time || data.createdAt == resource.data.createdAt);
    }

    function isValidWatchlistItem(data) {
      return data.keys().hasAll(['userId', 'movieId', 'addedAt']) &&
             data.userId == request.auth.uid &&
             data.movieId is string &&
             data.movieId.size() <= 256 &&
             (data.addedAt == request.time || data.addedAt == resource.data.addedAt);
    }

    function isValidConversation(data) {
      return data.keys().hasAll(['userId', 'messages']) &&
             data.userId == request.auth.uid &&
             data.messages is list &&
             data.messages.size() <= 100;
    }

    function isValidSubscriber(data) {
      return data.keys().hasAll(['email', 'userId', 'subscribedAt']) &&
             data.email is string &&
             data.email.size() <= 256 &&
             data.userId == request.auth.uid &&
             (data.subscribedAt == request.time || data.subscribedAt == resource.data.subscribedAt);
    }

    function isValidComment(data) {
      return data.keys().hasAll(['userId', 'userName', 'movieId', 'content', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.content is string &&
             data.content.size() <= 2000 &&
             (data.createdAt == request.time || data.createdAt == resource.data.createdAt);
    }

    function isValidRating(data) {
      return data.keys().hasAll(['userId', 'movieId', 'type', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             data.type in ['like', 'dislike'] &&
             (data.updatedAt == request.time || data.updatedAt == resource.data.updatedAt);
    }

    // 1. Entity Matches
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'createdAt']);
    }

    match /subscribers/{subId} {
      allow get: if isOwner(subId);
      allow create: if isOwner(subId) && isValidSubscriber(incoming());
      allow update: if isOwner(subId) && isValidSubscriber(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['email', 'userId', 'subscribedAt']);
    }

    match /scans/{scanId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || scanId == 'placeholder');
      allow create: if isSignedIn() && isValidScan(incoming());
    }

    match /watchlists/{watchId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidWatchlistItem(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /conversations/{convId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidConversation(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidConversation(incoming());
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidComment(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidRating(incoming()) && ratingId == request.auth.uid + "_" + incoming().movieId;
      allow update: if isSignedIn() && isValidRating(incoming()) && existing().userId == request.auth.uid && ratingId == request.auth.uid + "_" + incoming().movieId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
