# MongoDB Atlas Connection String
# Format: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGODB_URL=""

# JWT Secret for auth tokens (generate a strong random string)
JWT_SECRET=""

# Frontend URL for CORS (e.g., https://cight.ai)
FRONTEND_URL=""

# Server Port (default: 8080)
PORT=8080

# --- Client-side (VITE_) env vars go in .env ---
# VITE_TMDB_API_KEY=""
# GEMINI_API_KEY=""
